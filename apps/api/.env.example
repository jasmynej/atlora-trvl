# Copy to apps/api/.env and fill in real values. Never commit .env.

# The running API's connection. Must be atlora_app (docker/init/01-roles.sql,
# Milestone 2) — an ordinary role with DML only, no DDL, not a table owner.
# Never point this at atlora_owner; that role exists only for migrations.
DATABASE_URL="postgresql://atlora_app:atlora_app@localhost:5433/atlora"

# Which storage driver apps/api/src/lib/storage loads — "minio" or "r2".
# Only that driver's block below needs real values.
STORAGE_DRIVER="minio"

# MinIO (docker/compose.yaml's `storage` service — local dev default).
MINIO_ENDPOINT="http://localhost:9000"
MINIO_BUCKET_NAME="atlora-travel"
MINIO_ACCESS_KEY_ID="minioadmin"
MINIO_SECRET_ACCESS_KEY="minioadmin"

# Cloudflare R2 (set STORAGE_DRIVER=r2 above to use this instead).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="atlora-travel"
R2_PUBLIC_URL=""
