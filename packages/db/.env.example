# Copy to packages/db/.env and fill in real values. Never commit .env.

# drizzle-kit (migrate/generate/studio) reads this. Must be atlora_owner —
# the only role with DDL rights (docker/init/01-roles.sql, Milestone 2).
# Never point this at atlora_app or atlora_ai_ro; migrations will fail with
# "permission denied for schema public".
DATABASE_URL="postgresql://atlora_owner:atlora_owner@localhost:5433/atlora"

# Only needed to run src/seed.ts (one-off country-data seed).
RESTCOUNTRIES_TOKEN=""
