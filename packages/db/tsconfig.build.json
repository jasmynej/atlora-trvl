{
  // Used only by the apps/api Docker build (docker/scripts/patch-workspace-
  // exports.js). package.json's own "build" script points here. This
  // package's normal tsconfig.json is dev/typecheck-only ("noEmit": true,
  // "module": "ESNext") and stays that way — tsx/drizzle-kit read that one.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node10",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true
  },
  // Only the actual library surface (what src/index.ts exports) — not
  // seed.ts/seedGeography.ts. Those are standalone tsx-run scripts, use
  // top-level await (invalid under CommonJS output), and nothing in the
  // library imports them.
  "include": ["src/index.ts", "src/schema.ts", "src/relations.ts"]
}
